# Atelier backend env — copy to .env and fill in your values.
# .env is gitignored; .env.example is the template that ships in OSS.

# Resend API key for transactional email (sign-in / password-reset).
# Optional in dev — when missing, magic links are written to the host log
# instead of being mailed.
RESEND_API_KEY=

# Mail "From" header. Must be a verified sender on your Resend account.
ATELIER_MAIL_FROM=Atelier <noreply@example.com>

# Public origin used to compose magic-link / reset URLs in outbound mail.
# In dev: http://localhost:5174  (frontend port)
# In prod: your tunnel / public hostname.
ATELIER_PUBLIC_URL=http://localhost:5174

# Backend listen port.
ATELIER_PORT=3001
